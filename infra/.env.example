# CIDA Craft — environment
# Copy to `.env` and fill real values. Never commit `.env` (gitignored).
# Empty values disable the feature (e.g. RESTIC_REPOSITORY, BILLER_COMP_CODE).

# --- Postgres ---------------------------------------------------------------
POSTGRES_USER=cida
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=cida

# --- Valkey (queue / rate-limit backend) -------------------------------------
VALKEY_PASSWORD=CHANGE_ME

# --- MinIO (object storage) --------------------------------------------------
MINIO_ROOT_USER=cida
MINIO_ROOT_PASSWORD=CHANGE_ME
# Bucket used by the API for product/media objects.
S3_BUCKET=cida-media
# Bucket mirrored to the backup volume (MinIO mirror). Defaults to cida-craft.
MINIO_BUCKET=cida-craft
S3_REGION=us-east-1

# --- Sessions ----------------------------------------------------------------
# Secret used to sign session cookies. Must be >= 32 chars, random.
SESSION_SECRET=CHANGE_ME_AT_LEAST_32_CHARS
# true in prod (HTTPS-only cookie), false in dev (plain HTTP on localhost).
COOKIE_SECURE=false
# Cookie domain. localhost in dev; your VPS/domain in prod.
COOKIE_DOMAIN=localhost

# --- Sites -------------------------------------------------------------------
# Public origin (scheme + host) the API and storefront operate under.
# Scheme-carrying so http://localhost stays plain HTTP while prod domains get ACME.
APP_URL=http://localhost
SITE_URL=http://localhost
# Prod only: host port for HTTP (default 80). 443 is always used for TLS.
HTTP_PORT=80

# --- Payments reconciliation --------------------------------------------------
# fake | promptpay_billpay | promptpay_ewallet | bank_transfer
RECONCILIATION_PROVIDER=fake
# Biller company code for PromptPay Bill Payment (Ref1 = order_no). Empty disables.
BILLER_COMP_CODE=

# --- Backup / restic (offsite) ------------------------------------------------
# restic repository URL + password. Empty repository disables the offsite leg.
RESTIC_REPOSITORY=
RESTIC_PASSWORD=
# Number of local .dump files to keep before pruning (default 7).
KEEP_LOCAL=7
