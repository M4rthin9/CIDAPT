# CIDA Craft — environment template.
# Copy to .env and fill values. Never commit real values.
# Every key here must be parsed by the boot-time Zod config schema of its consumer.
# For compose interpolation, copy to infra/.env (compose reads it from the project dir).

# --- Edge (P1) ---
# Scheme matters: http://... serves plain HTTP; https://domain enables Caddy ACME.
# Dev default stays on http so no self-signed cert warnings.
SITE_URL=http://localhost
HTTP_PORT=80
# ACME account email for Let's Encrypt in prod; empty is allowed
ACME_EMAIL=

# --- App (P1/P4) ---
# NODE_ENV: development | production
NODE_ENV= development
# LOG_LEVEL: trace|debug|info|warn|error (pino)
LOG_LEVEL=
# Public base URL, e.g. https://shop.example.go.th (no trailing slash)
APP_URL=

# --- Storefront SSR (P8) ---
# How apps/web reaches the API from inside the compose network. Defaults to
# http://localhost:3000 for host-side development.
API_INTERNAL_URL=http://api:3000
# Host port the Vite dev server binds (default 5173); override when it is taken.
WEB_PORT=

# --- Postgres (P1/P2) ---
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=cida
# Shape: postgres://<user>:<password>@postgres:5432/<db>
DATABASE_URL=

# --- Valkey (P1/P7) ---
VALKEY_PASSWORD=
# Shape: redis://:<password>@valkey:6379
VALKEY_URL=

# --- MinIO / S3 (P1/P4) ---
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=
# Shape: http://minio:9000
S3_ENDPOINT=
S3_BUCKET=cida-media

# --- Gotenberg (P1/P6) ---
# Shape: http://gotenberg:3000
GOTENBERG_URL=

# --- SMTP / Mailpit in dev (P7) ---
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# --- LINE Messaging API (P7) ---
LINE_CHANNEL_ACCESS_TOKEN=
LINE_CHANNEL_SECRET=

# --- Payments reconciliation (P5) ---
# RECONCILIATION_PROVIDER: fake | <real provider id once chosen>
RECONCILIATION_PROVIDER=fake
# Backend-selected rail precedence: Bill Pay (if BILLER_COMP_CODE) -> PromptPay
# transfer (if PROMPTPAY_NUMBER) -> bank transfer (BANK_*). The buyer never picks;
# selectPaymentRail() resolves it server-side. Empty value disables that rail.
# PromptPay bill-payment biller comp code; empty disables billpay rail default
BILLER_COMP_CODE=
# Merchant PromptPay mobile number for the tag-29 transfer rail: 0XXXXXXXXX or
# 66XXXXXXXXX only — that is what the QR builder can encode, and any other value
# fails at boot rather than at a customer's checkout. Empty disables the rail and
# falls through to BANK_* below. (A 13-digit national ID or 15-digit eWallet ID
# would need buildRailPayload() extended first — @payments-review territory.)
PROMPTPAY_NUMBER=
# Bank-transfer rail display details (shown when no QR rail is configured)
BANK_NAME=Krungthai Bank
BANK_ACCOUNT_NAME=ทัณฑสถานบำบัดพิเศษกลาง
BANK_ACCOUNT_NO=1371094888

# --- Admin auth (P4) ---
SESSION_SECRET=
# Bootstrap superadmin created by seed only; rotate after first login
ADMIN_BOOTSTRAP_EMAIL=
ADMIN_BOOTSTRAP_PASSWORD=
